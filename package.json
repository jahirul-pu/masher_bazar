{
  "name": "masik-bazar-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Masik Bazar - Household Grocery Operating System",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @masik/database db:generate",
    "db:push": "pnpm --filter @masik/database db:push",
    "db:seed": "pnpm --filter @masik/database db:seed",
    "db:studio": "pnpm --filter @masik/database db:studio"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.3"
  }
}
