# ==========================================
# Masik Bazar Environment Configuration
# ==========================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/masik_bazar?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"

# JWT Secret
JWT_SECRET="masik_bazar_super_secure_jwt_secret_2026"
JWT_EXPIRATION="7d"

# Payment Gateways (Sandbox Mocks active by default)
USE_MOCK_PAYMENTS="true"
BKASH_APP_KEY="sandbox_app_key"
BKASH_APP_SECRET="sandbox_app_secret"
BKASH_USERNAME="sandbox_username"
BKASH_PASSWORD="sandbox_password"

NAGAD_MERCHANT_ID="sandbox_merchant"
NAGAD_PUBLIC_KEY="sandbox_public_key"
NAGAD_PRIVATE_KEY="sandbox_private_key"

SSLCOMMERZ_STORE_ID="sandbox_store_id"
SSLCOMMERZ_STORE_PASSWD="sandbox_store_passwd"
SSLCOMMERZ_IS_LIVE="false"

# SMS Gateway (Sandbox Mocks active by default)
USE_MOCK_SMS="true"
SSL_WIRELESS_API_TOKEN="sandbox_sms_token"
SSL_WIRELESS_SID="sandbox_sid"

# AI Services
GEMINI_API_KEY=""
